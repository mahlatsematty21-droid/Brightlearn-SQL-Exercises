
--- INNER JOIN ORDERS WITH CUSTOMERS AND PRODUCT NAME
---E.O COLUMNS : ORDER_ID,CUSTOMERNAME,PRODUCT_NAME,QUANTITY

SELECT A.ORDERID,
       A. ORDERDATE,
       B. CUSTOMERNAME,
       C. PRODUCTNAME,
       A. QUANTITY       
FROM PRACTICAL_2.LARGE.ORDERS AS A
INNER JOIN PRACTICAL_2.LARGE.CUSTOMERS AS B ON A.CUSTOMERID =B.CUSTOMERID
INNER JOIN PRACTICAL_2.LARGE.PRODUCTS AS C ON A.PRODUCTID = C.PRODUCTID;

---INNER JOIN CUSTOMERS WHO PLACED ORDERS 
---E.O COLUMNS : CUSTOMERID,CUSTOMERNAME,COUNTRY,ORDERID,ORDERDATE

SELECT C.CUSTOMERID,
       C. CUSTOMERNAME,
       C. COUNTRY,
       O.ORDERID,
       O.ORDERDATE
FROM PRACTICAL_2.LARGE.CUSTOMERS AS C
INNER JOIN PRACTICAL_2.LARGE.ORDERS AS O
ON C.CUSTOMERID = O .CUSTOMERID;

---LEFT JOIN 
--- E.O COLUMNS : CUSTOMERID,CUSTOMERNAME,COUNTRY,ORDERID,ORDERDATE,PRODUCTID,QUANTITY

SELECT C.CUSTOMERID,
       C.CUSTOMERNAME,
       C.COUNTRY,
       O.ORDERID,
       O.ORDERDATE,
       O.PRODUCTID,
       O.QUANTITY
FROM PRACTICAL_2.LARGE.CUSTOMERS AS C
LEFT JOIN PRACTICAL_2.LARGE.ORDERS AS O ON C.CUSTOMERID = O.CUSTOMERID;



---LEFT JOIN 
---E.O COLUMNS : PRODUCT ID,PRODUCT NAME,TOTALORDERS

SELECT C.PRODUCTID,
       C.PRODUCTNAME,
COUNT(O.ORDERID) AS TOTALORDERS
FROM PRACTICAL_2.LARGE.PRODUCTS AS C
LEFT JOIN PRACTICAL_2.LARGE.ORDERS AS O
ON C.PRODUCTNAME = C.PRODUCTNAME
GROUP BY C.PRODUCTID,C.PRODUCTNAME
ORDER BY C.PRODUCTID;

---RIGHT JOIN 
--E.O COLUMNS ORDERID,ORDERDATE,PRODUCTID,PRODUCTNAME,PRICE,QUANTITY

SELECT O.ORDERID,
       O.ORDERDATE,
       C.PRODUCTID,
       C.PRODUCTNAME,
       C.PRICE,
       O.QUANTITY
FROM PRACTICAL_2.LARGE.ORDERS AS O
RIGHT JOIN PRACTICAL_2.LARGE.PRODUCTS AS C ON O.PRODUCTID = C.PRODUCTID
ORDER BY C.PRODUCTID,O.ORDERID;

---RIGHT JOIN
--E.O COLUMNS: CUSTOMERID,CUSTOMERNAME,COUNTRY,ORDERID,ORDERDATE,PRODUCTID,QUANTITY

SELECT C.CUSTOMERID,
       C.CUSTOMERNAME,
       C.COUNTRY,
       O.ORDERID,
       O.ORDERDATE,
       O.PRODUCTID,
       O.QUANTITY
FROM PRACTICAL_2.LARGE.CUSTOMERS AS C
LEFT JOIN PRACTICAL_2.LARGE.ORDERS AS O
ON C.CUSTOMERID = O.CUSTOMERID
ORDER BY C.CUSTOMERID,O.ORDERDATE;

---FULL OUTER JOIN
---E.O COLUMNS : CUSTOMERID,CUSTOMERNAME,COUNTRY,ORDERID,RDERDATE,PRODUCTID,QUANTITY

SELECT C.CUSTOMERID,
       C.CUSTOMERNAME,
       C.COUNTRY,
       O.ORDERID,
       O.ORDERDATE,
       O.PRODUCTID,
       O.QUANTITY
FROM PRACTICAL_2.LARGE.CUSTOMERS AS C
FULL OUTER JOIN PRACTICAL_2.LARGE.ORDERS AS O ON C.CUSTOMERID = O.CUSTOMERID
ORDER BY COALESCE(C.CUSTOMERID,O.CUSTOMERID);


---FULL OUTER JOIN
--E.O COLUMNS

SELECT C.PRODUCTID,
       C.PRODUCTNAME,
       C.PRICE,
       O.ORDERID,
       O.ORDERDATE,
       O.CUSTOMERID,
       O.QUANTITY
 FROM PRACTICAL_2.LARGE.PRODUCTS AS C
 FULL OUTER JOIN PRACTICAL_2.LARGE.ORDERS AS O
 ON C.PRODUCTID = O.PRODUCTID
 ORDER BY COALESCE(C.PRODUCTID,O.PRODUCTID);
       

