SELECT CUSTOMER_ID,
       SIZE,
       PURCHASE_AMOUNT,
       ITEM_PURCHASED
 FROM PRACTICAL_3.SHOPPINGSALES.SALES
 WHERE SIZE IS NULL
 AND PURCHASE_AMOUNT > 50;

 SELECT COALESCE(SEASON,'UNKNOWN SEASON')AS SEASON,
 COUNT(*)AS TOTAL_PURCHASES
 FROM PRACTICAL_3.SHOPPINGSALES.SALES
 GROUP BY COALESCE(SEASON,'UNKNOWN SEASON')
 ORDER BY SEASON;

 SELECT COALESCE(PAYMENT_METHOD,'NOT PROVIDED')AS PAYMENT_METHOD,
 COUNT(DISTINCT CUSTOMER_ID)AS CUSTOMER_COUNT
 FROM PRACTICAL_3.SHOPPINGSALES.SALES
 GROUP BY COALESCE(PAYMENT_METHOD,'NOT PROVIDED')
 ORDER BY CUSTOMER_COUNT DESC;

 --Q4
 SELECT CUSTOMER_ID,
        PROMO_CODE_USED,
        REVIEW_RATING,
        ITEM_PURCHASED
FROM PRACTICAL_3.SHOPPINGSALES.SALES
WHERE PROMO_CODE_USED IS NULL
AND REVIEW_RATING < 3.0;

--Q5

SELECT SHIPPING_TYPE AS SHIPPING_TYPE,
       AVG(COALESCE(PURCHASE_AMOUNT,0)) AS AVERAGE_PURCHASE_AMOUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY SHIPPING_TYPE
ORDER BY SHIPPING_TYPE;

--Q6

SELECT 
       LOCATION,
       COUNT(*) AS TOTAL_PURCHASES
FROM  PRACTICAL_3.SHOPPINGSALES.SALES
WHERE PAYMENT_METHOD IS NOT NULL
GROUP BY LOCATION
HAVING COUNT(*)> 5
ORDER BY TOTAL_PURCHASES DESC;

---Q7
SELECT CUSTOMER_ID,
       COALESCE(PURCHASE_AMOUNT,0) AS PURCHASE_AMOUNT,
       CASE
       WHEN COALESCE(PURCHASE_AMOUNT,0)>80 THEN 'HIGH'
       WHEN COALESCE(PURCHASE_AMOUNT,0)BETWEEN 50 AND 80 THEN 'MEDIUM'
       ELSE 'LOW'
       END AS SPENDER_CATEGORY
FROM PRACTICAL_3.SHOPPINGSALES.SALES; 

--Q8

SELECT CUSTOMER_ID,
       COLOR,
       PREVIOUS_PURCHASES
FROM PRACTICAL_3.SHOPPINGSALES.SALES
WHERE PREVIOUS_PURCHASES IS NULL
AND COLOR IS NOT NULL;

--Q9
SELECT COALESCE(FREQUENCY_OF_PURCHASES,'UNKNOWN') AS FREQUENCY_OF_PURCHASES,
SUM(COALESCE(PURCHASE_AMOUNT,0)) AS TOTAL_PURCHASE_AMOUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY COALESCE(FREQUENCY_OF_PURCHASES,'UNKNOWN')
ORDER BY TOTAL_PURCHASE_AMOUNT DESC;

--Q10

SELECT CATEGORY,
COUNT(*) AS TOTAL_PURCHASES
FROM PRACTICAL_3.SHOPPINGSALES.SALES
WHERE CATEGORY IS NOT NULL
GROUP BY CATEGORY
ORDER BY TOTAL_PURCHASES DESC;

--Q11
SELECT LOCATION,
SUM (COALESCE(PURCHASE_AMOUNT,0)) AS TOTAL_PURCHASE_AMOUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY LOCATION
ORDER BY TOTAL_PURCHASE_AMOUNT DESC
LIMIT 5;

--Q12
SELECT
GENDER,
SIZE,
SUM(CASE WHEN COLOR IS NULL THEN 1 ELSE 0 END) AS NULL_COLOR_COUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY GENDER,SIZE
ORDER BY GENDER,SIZE;

--Q13

SELECT ITEM_PURCHASED,
SUM (CASE WHEN SHIPPING_TYPE IS NULL THEN 1 ELSE 0 END ) AS NULL_SHIPPING_TYPE_COUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY ITEM_PURCHASED
HAVING SUM (CASE WHEN SHIPPING_TYPE IS NULL THEN 1 ELSE 0 END )>3
ORDER BY NULL_SHIPPING_TYPE_COUNT DESC;

--Q14
SELECT COALESCE (PAYMENT_METHOD,'NOT PROVIDED')AS PAYMENT_METHOD,
SUM (CASE WHEN REVIEW_RATING IS NULL THEN 1 ELSE 0 END)AS MISSING_REVIEW_RATING_COUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY COALESCE (PAYMENT_METHOD,'NOT PROVIDED')
ORDER BY MISSING_REVIEW_RATING_COUNT DESC;

--Q16
SELECT 'NULL'AS COLOR,
AVG(AGE) AS AVERAGE_AGE
FROM PRACTICAL_3.SHOPPINGSALES.SALES
WHERE COLOR IS NULL 
GROUP BY COLOR
HAVING COUNT(*)>=2;

--Q17
SELECT CASE 
WHEN SHIPPING_TYPE IN ('EXPRESS','NEXT DAY AIR') THEN 'FAST'
WHEN SHIPPING_TYPE = 'STANDARD' THEN 'SLOW'
ELSE 'OTHER'
END AS DELIVERY_SPEED,
COUNT(DISTINCT CUSTOMER_ID)AS CUSTOMER_COUNT
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY 1
ORDER BY CUSTOMER_COUNT DESC;

--Q15
SELECT CATEGORY,
AVG (COALESCE(REVIEW_RATING,0))AS AVERAGE_REVIEW_RATING
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY CATEGORY
HAVING AVG (COALESCE(REVIEW_RATING,0))>3.5
ORDER BY AVERAGE_REVIEW_RATING DESC;

--Q18
SELECT CUSTOMER_ID,
PURCHASE_AMOUNT,
PROMO_CODE_USED
FROM PRACTICAL_3.SHOPPINGSALES.SALES
WHERE PURCHASE_AMOUNT IS NULL 
AND PROMO_CODE_USED = 'YES';

--Q19

SELECT LOCATION,
MAX(COALESCE(PREVIOUS_PURCHASES,0)) AS MAX_PREVIOUS_PURCHASES,
AVG(COALESCE(REVIEW_RATING,0))AS AVERAGE_REVIEW_RATING
FROM PRACTICAL_3.SHOPPINGSALES.SALES
GROUP BY LOCATION
HAVING AVG(COALESCE(REVIEW_RATING,0))>4.0
ORDER BY AVERAGE_REVIEW_RATING DESC;

--Q20
SELECT CUSTOMER_ID,
SHIPPING_TYPE,
PURCHASE_AMOUNT,
ITEM_PURCHASED
FROM PRACTICAL_3.SHOPPINGSALES.SALES
WHERE SHIPPING_TYPE IS NULL 
AND COALESCE(PURCHASE_AMOUNT,0)BETWEEN 30 AND 70;
